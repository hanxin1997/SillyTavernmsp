<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/web_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_white">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/browser_bar_height"
        android:background="@color/ink_white"
        android:overScrollMode="never" />

    <TextView
        android:id="@+id/loading_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/browser_bar_height"
        android:background="@color/ink_white"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/loading"
        android:textColor="@color/ink_black"
        android:textSize="18sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/browser_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/browser_bar_height"
        android:layout_gravity="bottom"
        android:background="@drawable/browser_bar_background"
        android:elevation="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/back"
            android:src="@android:drawable/ic_media_previous"
            android:tooltipText="@string/back" />

        <ImageButton
            android:id="@+id/forward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/forward"
            android:src="@android:drawable/ic_media_next"
            android:tooltipText="@string/forward" />

        <ImageButton
            android:id="@+id/reload"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/reload"
            android:src="@android:drawable/ic_popup_sync"
            android:tooltipText="@string/reload" />

        <ImageButton
            android:id="@+id/home"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/home"
            android:src="@android:drawable/ic_menu_view"
            android:tooltipText="@string/home" />

        <ImageButton
            android:id="@+id/fullscreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/enter_fullscreen"
            android:src="@drawable/ic_fullscreen"
            android:tooltipText="@string/enter_fullscreen" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/settings"
            android:src="@android:drawable/ic_menu_preferences"
            android:tooltipText="@string/settings" />
    </LinearLayout>

    <!-- Keep this native control above the WebView so an e-ink user can always leave fullscreen. -->
    <ImageButton
        android:id="@+id/fullscreen_restore"
        android:layout_width="72dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/fullscreen_restore_background"
        android:contentDescription="@string/exit_fullscreen"
        android:padding="12dp"
        android:src="@drawable/ic_fullscreen_exit"
        android:tooltipText="@string/exit_fullscreen"
        android:visibility="gone" />
</FrameLayout>
